DATABASE_URL="file:./dev.db"
# Secret de signature des sessions. OBLIGATOIRE en production (32 caractères minimum, valeur aléatoire) :
# le serveur refuse de démarrer avec une valeur absente, trop courte ou d'exemple.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="votre_secret_jwt_a_remplacer"
APP_URL="http://localhost:3600"

# Google OAuth 2.0 (Authentification Google pour les enseignants)
# Créez vos identifiants sur : https://console.cloud.google.com/apis/credentials
# Type d'application : Application Web
# URI de redirection autorisée : http://localhost:3600/api/auth/google/callback
GOOGLE_CLIENT_ID="votre_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre_google_client_secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="votre_google_client_id.apps.googleusercontent.com"

# Configuration OpenRouter (IA multi-modèles)
# Créez votre clé sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"
